<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>Rilmo Recorder</AssemblyName>
    <RootNamespace>Rilmo</RootNamespace>
    <Version>0.4.2</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Rilmo Screen Recorder</Product>
    <Company>Muhammad Hasnain</Company>
    <Authors>Muhammad Hasnain</Authors>
    <Description>Screen recording, scene composition, streaming and replay capture.</Description>
    <RepositoryUrl>https://github.com/Hasnain4700/rilmo-screen-recorder</RepositoryUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\recorder.ico</ApplicationIcon>
    <StartupObject>Rilmo.App</StartupObject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RilmoTestMode)' == 'true'"><DefineConstants>$(DefineConstants);RILMO_TEST</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(RilmoStoreEdition)' == 'true'"><DefineConstants>$(DefineConstants);RILMO_STORE</DefineConstants></PropertyGroup>
  <ItemGroup Condition="'$(RilmoStoreEdition)' == 'true'"><AssemblyMetadata Include="RilmoEdition" Value="MicrosoftStore" /></ItemGroup>
  <ItemGroup><Compile Remove="Engine\MuxRelay.cs" /></ItemGroup>
  <ItemGroup>
    <Resource Include="..\assets\rilmo-logo.png" Link="Assets\rilmo-logo.png" />
    <Resource Include="..\assets\recorder.ico" Link="Assets\recorder.ico" />
    <Resource Include="..\assets\fonts\DoppioOne-Regular.ttf" Link="Assets\Fonts\DoppioOne-Regular.ttf" />
    <Content Include="..\assets\fonts\OFL.txt" Link="licenses\DoppioOne-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
