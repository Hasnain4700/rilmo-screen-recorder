<Window x:Class="Rilmo.SceneEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Rilmo · Scene editor" Width="1120" Height="760" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="SemiBold">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
 <Border BorderBrush="#30343B" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
  <Grid Margin="20,0" MouseLeftButtonDown="Title_Drag"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" Background="{StaticResource AccentSurfaceBrush}" CornerRadius="7" Margin="0,0,12,0"><Path Data="M 1,1 H 12 V 12 H 1 Z M 6,6 H 17 V 17 H 6 Z" Stroke="{StaticResource AccentTextBrush}" StrokeThickness="1.5" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Scene studio" FontSize="19" FontWeight="Bold"/><TextBlock Text="Create a shot. Make it yours." Style="{StaticResource Eyebrow}"/></StackPanel></StackPanel><Button Content="×" FontSize="22" Style="{StaticResource CaptionButton}" HorizontalAlignment="Right" Click="Close_Click" AutomationProperties.Name="Close scene editor"/></Grid>
  <Grid x:Name="EditorWorkspace" Grid.Row="1" Margin="18,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Your scenes" Style="{StaticResource Eyebrow}" Margin="5,6,0,12"/><ListBox x:Name="ScenesList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="Scene_Selected" AutomationProperties.Name="Scenes"/><StackPanel Grid.Row="2"><Button Content="＋ New scene" Click="AddScene_Click" Margin="0,10,0,7"/><UniformGrid Columns="2"><Button Content="Copy" Click="CopyScene_Click" FontSize="13" Padding="5,8" Margin="0,0,3,0"/><Button Content="Remove" Click="RemoveScene_Click" FontSize="13" Padding="5,8" Margin="3,0,0,0"/></UniformGrid><Button Content="Import / export…" Click="Files_Click" Style="{StaticResource QuietButton}" FontSize="13" Margin="0,8,0,0" Padding="6,8"/></StackPanel></Grid></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SceneNameBox" FontSize="15" FontWeight="Bold" MaxLength="60" TextChanged="SceneName_Changed" AutomationProperties.Name="Scene name"/><Button Grid.Column="1" Content="Preview frame" Click="Preview_Click" Margin="10,0,0,0" ToolTip="Capture one frame of the applied scene. Browser URLs may connect when previewing."/></Grid>
    <Border Grid.Row="1" CornerRadius="9" BorderBrush="#30343B" BorderThickness="1" Background="#101113" ClipToBounds="True"><Grid><Viewbox x:Name="LayoutView" Stretch="Uniform" Margin="10"><Canvas x:Name="LayoutCanvas" Width="1280" Height="720" Background="#181A1E" ClipToBounds="True"/></Viewbox><Image x:Name="FramePreview" Stretch="Uniform" Visibility="Collapsed"/><Border Background="#EE181A1E" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"><TextBlock x:Name="CanvasHint" Text="Layout map · drag to position" FontSize="11" Foreground="#A6ABB4"/></Border><Button x:Name="BackToLayoutButton" Content="Back to layout" Click="Layout_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Margin="12" Padding="10,6" FontSize="13"/></Grid></Border>
    <Grid Grid.Row="2" Margin="0,12,0,10"><TextBlock Text="Layers · top item is in front" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button Content="＋ Add source" HorizontalAlignment="Right" Click="AddSource_Click" Padding="12,7" Style="{StaticResource PrimaryButton}"/></Grid>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ListBox x:Name="SourcesList" SelectionChanged="Source_Selected" MouseDoubleClick="EditSource_Click" AutomationProperties.Name="Scene layers"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,4"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 1,1 H 12 V 12 H 1 Z M 6,6 H 17 V 17 H 6 Z" Stroke="{StaticResource AccentTextBrush}" StrokeThickness="1.5" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Column="1" Margin="10,0,0,0"><Button Content="Edit" Click="EditSource_Click" MinWidth="64" Padding="9,6" MinHeight="28"/><Button Content="↑" Click="LayerUp_Click" Padding="9,2" MinHeight="26" Margin="0,4,0,0" AutomationProperties.Name="Move layer forward"/><Button Content="↓" Click="LayerDown_Click" Padding="9,2" MinHeight="26" AutomationProperties.Name="Move layer backward"/><Button Content="Remove" Click="RemoveSource_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="5,4" MinHeight="25"/></StackPanel></Grid></Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="76"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="EditorStatus" Text="Edits stay in the layout until you apply them." FontSize="13" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,15,0"/><ComboBox x:Name="TransitionPicker" Grid.Column="1" SelectedIndex="1" AutomationProperties.Name="Scene transition"><ComboBoxItem Content="Cut"/><ComboBoxItem Content="Fade"/><ComboBoxItem Content="Swipe"/><ComboBoxItem Content="Slide"/><ComboBoxItem Content="Fade to black"/></ComboBox><TextBox x:Name="DurationBox" Grid.Column="2" Text="300" Margin="7,0" ToolTip="Transition duration in milliseconds (50–2000)" AutomationProperties.Name="Transition duration in milliseconds"/><Button Grid.Column="3" x:Name="ApplyButton" Content="Apply scene" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/></Grid>
 </Grid></Border>
</Window>
