1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 2
FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Muhammad Hasnain\0"
   VALUE "FileDescription", "Rilmo Virtual Camera\0"
   VALUE "FileVersion", "@VERSION@\0"
   VALUE "InternalName", "@FILENAME@\0"
   VALUE "OriginalFilename", "@FILENAME@\0"
   VALUE "ProductName", "Rilmo Screen Recorder\0"
   VALUE "ProductVersion", "@VERSION@\0"
   VALUE "LegalCopyright", "Rilmo contributors and OBS Project contributors\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
